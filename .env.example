# Saakshi environment. Nothing here is required locally: with no .env every provider uses its
# mock and the database is PGlite in ./.data/pglite. A provider switches to "real" only when ALL
# of its variables are set. Check /dev/status to see what is active.
# Never prefix a secret with NEXT_PUBLIC_ (that ships it to the browser).

# --- App -------------------------------------------------------------------------------------
# Public base URL (Cloudinary notification_url, absolute links). Default: http://localhost:$PORT (3000).
APP_URL=
# Contact in the Nominatim and Wikimedia User-Agents (both usage policies ask for one).
# Strongly recommended before `pnpm archive:discover`: anonymous clients are throttled harder.
APP_CONTACT_EMAIL=
# Signs capture tokens (and derives the mock media URL-signing key). Required in production;
# in development an insecure default is used with a warning. Use 32+ random characters.
CAPTURE_TOKEN_SECRET=
# Project URL: the Wikimedia User-Agent falls back to it when APP_CONTACT_EMAIL is unset.
APP_REPO_URL=

# --- Media + analysis: Cloudinary (all three → real) ------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Mock media store (originals, sidecars, rendered cache). Default: ./.data/media
MEDIA_MOCK_DIR=

# --- AI: OpenAI (key → real) -----------------------------------------------------------------
OPENAI_API_KEY=
# Default: gpt-5.6-luna
OPENAI_MODEL_FAST=
# Default: same as OPENAI_MODEL_FAST
OPENAI_MODEL_SMART=
# Default: text-embedding-3-small (1536 dimensions, matching the vector(1536) column)
OPENAI_EMBED_MODEL=

# --- Database --------------------------------------------------------------------------------
# Postgres (e.g. Supabase) connection string → real. Empty → PGlite.
# For Supabase's transaction pooler the client already disables prepared statements.
DATABASE_URL=
# PGlite data directory. Default: ./.data/pglite
PGLITE_DIR=

# --- Queue --------------------------------------------------------------------------------------
# inline (default): pipeline runs in-process, concurrency 4.
# inngest-dev: real Inngest functions via the local Dev Server, no account:
#   npx inngest-cli@latest dev -u http://localhost:3000/api/inngest
QUEUE=
# Inngest cloud (both → real, overrides QUEUE).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Geocoder ----------------------------------------------------------------------------------
# Real Nominatim needs no key and is the default (1 req/s, results cached in the geocache table).
# Set to "mock" to stay fully offline (nearest-city names). Tests always use the mock.
GEOCODER=

# --- Demo data ------------------------------------------------------------------------------------
# Commons API responses + downloaded thumbnails (makes demo:reset offline). Default: ./.data/archive-cache
ARCHIVE_CACHE_DIR=
# Required as header x-demo-admin-secret for POST /api/demo/reset in production.
DEMO_ADMIN_SECRET=
# Set to 1 to enable /dev/* pages and APIs in production (always on in development).
DEV_TOOLS=
# Most photos measured (segmentation masks) per project, for pairs and spot trends.
MEASURE_MAX_PER_PROJECT=40
# Venue for `pnpm demo:stage` (the live-stage project). No default on purpose.
STAGE_LAT=
STAGE_LNG=

# --- Pipeline -------------------------------------------------------------------------------------
# Minimum cosine similarity to assign a photo to a project by content alone. Default: 0.45
ASSIGN_SIMILARITY_THRESHOLD=

# --- EXIF ------------------------------------------------------------------------------------
# UTC offset assumed for EXIF capture times that carry none (most phones). Default: +05:30
EXIF_DEFAULT_UTC_OFFSET=
